<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>deltablade</groupId>
    <artifactId>deltablade</artifactId>
    <version>1.0.8</version>
    <packaging>jar</packaging>

    <name>DeltaBlade</name>
    <description>Original arcade shooter game built with FXGL</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <fxgl.version>21.1</fxgl.version>
        <javafx.version>21.0.2</javafx.version>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Versiones de dependencias -->
        <junit.version>5.11.4</junit.version>

        <!-- Versiones de plugins -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <jacoco-maven-plugin.version>0.8.13</jacoco-maven-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>10.21.4</checkstyle.version>
        <app.version>${project.version}</app.version>
        <jpackage.type>APP_IMAGE</jpackage.type>
        <jpackage.icon>${project.basedir}/packaging/icons/deltablade.png</jpackage.icon>
        <inject.dmg.skip>true</inject.dmg.skip>
        <pack.arch.skip>true</pack.arch.skip>
        <pack.appimage.skip>true</pack.appimage.skip>
        <prism.order>es2,sw</prism.order>
        <!-- Stabil halten: sonst erzeugt jpackage jede EXE als neues Windows-Produkt. -->
        <jpackage.win.upgrade.uuid>6D2C415E-841E-3F95-A418-FEEE40105FDA</jpackage.win.upgrade.uuid>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.github.almasb</groupId>
            <artifactId>fxgl</artifactId>
            <version>${fxgl.version}</version>
        </dependency>
        <!-- Explicit JavaFX dependencies to ensure version consistency -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>javazoom</groupId>
            <artifactId>jlayer</artifactId>
            <version>1.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources-filtered</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- validate: comprueba la versión mínima de Java y de Maven -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-environment</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>DeltaBlade necesita Java 21 o superior (usa List.getFirst()/getLast(), añadidos en Java 21).</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.6.3,)</version>
                                    <message>DeltaBlade necesita Maven 3.6.3 o superior.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- compile: compilación con todas las advertencias activadas -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- test: ejecución de los tests unitarios con JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                </configuration>
            </plugin>
            <!-- verify: cobertura de los tests con JaCoCo (mínimo 70 % de líneas) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <configuration>
                    <!-- Solo se mide la lógica del juego; la interfaz FXGL/JavaFX necesita pantalla y no se prueba con tests unitarios -->
                    <includes>
                        <include>deltablade/AppVersion*</include>
                        <include>deltablade/GameVars*</include>
                        <include>deltablade/HighScoreStore*</include>
                        <include>deltablade/RankNames*</include>
                        <include>deltablade/ShopItem*</include>
                        <include>deltablade/ShopWeapon*</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- verify: convención de estilo con Checkstyle (falla si hay incumplimientos) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${project.basedir}/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy todir="${project.build.outputDirectory}/assets/textures" overwrite="true">
                                    <fileset dir="${project.basedir}/src/main/resources/assets/textures">
                                        <include name="**/*"/>
                                    </fileset>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>deltablade.DeltaBladeApp</mainClass>
                    <options>
                        <option>-Dprism.order=sw,es2</option>
                        <option>-Dprism.metal=false</option>
                        <option>-Djava.awt.headless=true</option>
                    </options>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>deltablade.DeltaBladeApp</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>deltablade.Launcher</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>deltablade.Launcher</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>dist-mac</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <jpackage.type>DMG</jpackage.type>
                <jpackage.icon>${project.basedir}/packaging/icons/deltablade.icns</jpackage.icon>
                <inject.dmg.skip>false</inject.dmg.skip>
                <prism.order>sw,es2</prism.order>
            </properties>
        </profile>
        <profile>
            <id>dist-win</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <jpackage.type>EXE</jpackage.type>
                <jpackage.icon>${project.basedir}/packaging/icons/deltablade.ico</jpackage.icon>
                <prism.order>d3d,sw</prism.order>
            </properties>
        </profile>
        <profile>
            <id>dist-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <properties>
                <jpackage.type>DEB</jpackage.type>
                <jpackage.icon>${project.basedir}/packaging/icons/deltablade.png</jpackage.icon>
                <pack.arch.skip>false</pack.arch.skip>
                <pack.appimage.skip>false</pack.appimage.skip>
                <prism.order>es2,sw</prism.order>
            </properties>
        </profile>
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>copy-runtime-deps</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>copy-app-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                              todir="${project.build.directory}/jpackage-input"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.6</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <name>DeltaBlade</name>
                            <appVersion>${app.version}</appVersion>
                            <vendor>DeltaBlade</vendor>
                            <copyright>DeltaBlade</copyright>
                            <description>Arcade shooter</description>
                            <destination>${project.build.directory}/dist</destination>
                            <input>${project.build.directory}/jpackage-input</input>
                            <mainJar>${project.build.finalName}.jar</mainJar>
                            <mainClass>deltablade.DeltaBladeApp</mainClass>
                            <type>${jpackage.type}</type>
                            <icon>${jpackage.icon}</icon>
                            <removeDestination>true</removeDestination>
                            <javaOptions>
                                <option>-Dprism.order=${prism.order}</option>
                                <option>-Dprism.metal=false</option>
                                <option>--enable-native-access=ALL-UNNAMED</option>
                                <option>-Xms128m</option>
                                <option>-Xmx512m</option>
                            </javaOptions>
                            <macPackageIdentifier>deltablade.DeltaBlade</macPackageIdentifier>
                            <macPackageName>DeltaBlade</macPackageName>
                            <macAppCategory>games</macAppCategory>
                            <winMenu>true</winMenu>
                            <winMenuGroup>DeltaBlade</winMenuGroup>
                            <winShortcut>true</winShortcut>
                            <winDirChooser>true</winDirChooser>
                            <winUpgradeUuid>${jpackage.win.upgrade.uuid}</winUpgradeUuid>
                            <linuxShortcut>true</linuxShortcut>
                            <linuxAppCategory>games</linuxAppCategory>
                            <linuxPackageName>deltablade</linuxPackageName>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>name-dist</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>deltablade.tools.NameDist</mainClass>
                                    <arguments>
                                        <argument>${app.version}</argument>
                                        <argument>${project.build.directory}/dist</argument>
                                    </arguments>
                                    <classpathScope>compile</classpathScope>
                                </configuration>
                            </execution>
                            <execution>
                                <id>pack-arch</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${pack.arch.skip}</skip>
                                    <executable>/bin/bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/packaging/linux/pack-arch.sh</argument>
                                        <argument>${app.version}</argument>
                                        <argument>${project.build.directory}/dist</argument>
                                        <argument>${project.basedir}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>pack-appimage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${pack.appimage.skip}</skip>
                                    <executable>/bin/bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/packaging/linux/pack-appimage.sh</argument>
                                        <argument>${app.version}</argument>
                                        <argument>${project.build.directory}/dist</argument>
                                        <argument>${project.basedir}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>inject-mac-dmg-content</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${inject.dmg.skip}</skip>
                                    <executable>/bin/bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/packaging/mac/inject-dmg-content.sh</argument>
                                        <argument>${project.build.directory}/dist</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>explosions</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <version>0.0.8</version>
                        <configuration>
                            <mainClass>deltablade.tools.ExplosionEditor</mainClass>
                            <options>
                                <option>-Dprism.order=sw,es2</option>
                                <option>-Dprism.metal=false</option>
                            </options>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
