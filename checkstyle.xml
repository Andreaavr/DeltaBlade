<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Convención de estilo de DeltaBlade.
    Basada en Sun/Google, adaptada al código del proyecto:
    sangría de 4 espacios y líneas de hasta 140 caracteres.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- Formato del fichero -->
    <module name="FileTabCharacter"/>
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="La línea tiene espacios al final."/>
    </module>
    <module name="LineLength">
        <property name="max" value="140"/>
        <!-- Se ignoran imports y las cadenas Base64 largas de EmbeddedTextures -->
        <property name="ignorePattern" value="^(package|import) .*|^\s*&quot;[A-Za-z0-9+/=]{100,}"/>
    </module>

    <module name="TreeWalker">
        <!-- Imports -->
        <!-- Se permite import static ...* para el DSL de FXGL (import static com.almasb.fxgl.dsl.FXGL.*) -->
        <module name="AvoidStarImport">
            <property name="allowStaticMemberImports" value="true"/>
        </module>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>

        <!-- Nombres -->
        <module name="PackageName"/>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="ConstantName"/>
        <module name="StaticVariableName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>

        <!-- Llaves y bloques -->
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="NeedBraces">
            <property name="allowSingleLineStatement" value="true"/>
        </module>

        <!-- Javadoc obligatorio en clases, interfaces, constructores y métodos públicos o protegidos -->
        <module name="MissingJavadocType">
            <property name="scope" value="protected"/>
        </module>
        <module name="MissingJavadocMethod">
            <property name="scope" value="protected"/>
            <property name="tokens" value="METHOD_DEF, CTOR_DEF, ANNOTATION_FIELD_DEF, COMPACT_CTOR_DEF"/>
        </module>
        <!-- Los comentarios deben incluir @param, @return y @throws cuando corresponda -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public, protected"/>
            <property name="validateThrows" value="true"/>
        </module>

        <!-- Buenas prácticas -->
        <module name="ModifierOrder"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="EqualsHashCode"/>
        <module name="OuterTypeFilename"/>
    </module>
</module>